NODE_ENV=development

# Default response-message locale for this forum installation.
FORUM_DEFAULT_LOCALE=vi-VN

# 应用名，用于显示pm2服务等场景
APP_NAME=pbn

# 主机/端口
HOST=127.0.0.1
PORT=7100

# 数据库
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pbn_dev

# 缓存配置
REDIS_URL=redis://127.0.0.1:16379/0

# 用户信息缓存配置（秒）
# 用于缓存用户角色、封禁状态等信息，减少数据库查询
# 建议值：开发环境 30-60，生产环境 120-300
USER_CACHE_TTL=30

# JWT 使用 `openssl rand -base64 32` 生成
# Generate a random local secret before running the API; never commit it.
# The API refuses to boot when this is empty, shorter than 32 characters, or a published placeholder.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=1y

# Proxy addresses allowed to set X-Forwarded-For and X-Forwarded-Proto.
# Default when unset: 127.0.0.1,::1. Never true, *, or 0.0.0.0/0.
# Docker: set the web/nginx container address or a narrow subnet, not the public internet.
# TRUSTED_PROXIES=127.0.0.1,::1

# CORS 跨域配置
# 支持逗号分隔的多个域名，支持通配符 (e.g. https://*.example.com)
# Also merged at runtime with FORUM_PUBLIC_ORIGIN / FORUM_WEB_ORIGIN.
# In development, ALLOWED_DEV_ORIGINS / FORUM_ALLOWED_HOSTS hostnames are expanded too.
# Never derived from Host / X-Forwarded-*. Do not use * or origin:true.
CORS_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
# Public HTTPS forum origin (Cloudflare Tunnel / production site). Used for CORS + OPS callback hints.
# FORUM_PUBLIC_ORIGIN=https://forum.example.com
# Dev-only extra hosts (bare hostnames, comma-separated) also allowed as CORS origins when NODE_ENV=development.
# ALLOWED_DEV_ORIGINS=pbn-dev.example.com,100.92.202.31

# ===== Forum Credit OPS (forum-credit/1) =====
# OPS-SERVER base URL (no trailing slash)
OPS_FORUM_BASE_URL=https://ops.seo-ops.duckdns.org
# Optional dedicated 32-byte KEK for machine credential encryption (hex 64 chars or base64).
# If unset, KEK is derived via scrypt from JWT_SECRET.
# OPS_FORUM_KEK=
# OPS_FORUM_KEK_VERSION=v1
# Public HTTPS origin OPS uses for /ops/v1/forum/* callbacks (preferred over site_url).
# Never use localhost — for local dev set a public HTTPS tunnel URL here or in Admin UI.
# FORUM_PUBLIC_ORIGIN=https://forum.example.com

# ===== Independent bank-transfer Credit top-up (SePay-first) =====
# Feature flag DEFAULT OFF — do not enable production without PO approval.
# BANK_PAYMENT_ENABLED=false
# BANK_PAYMENT_PUBLIC=false
# BANK_PAYMENT_SANDBOX=true
# BANK_PAYMENT_SANDBOX_GRANT=false
# BANK_PAYMENT_PROVIDER=sepay
# BANK_PAYMENT_ORDER_TTL_MINUTES=60
# SEPAY_WEBHOOK_SECRET=
# SEPAY_API_KEY=
# SEPAY_API_TOKEN=
# SEPAY_ACCOUNT_NUMBER=
# SEPAY_BANK_CODE=
# SEPAY_ACCOUNT_NAME=
# SEPAY_BANK_ACCOUNT_ID=
# SEPAY_PAYMENT_CODE_PREFIX=PBN

# ===== Forum Pricing OPS (forum-pricing/1) trusted signing keys =====
# Sync-response publicKey is NEVER trusted alone. Pin OPS public keys here.
# Option A: single active key
# FORUM_PRICING_TRUST_KEY_ID=fpk_v1
# FORUM_PRICING_TRUST_PUBLIC_KEY=<spki-base64url>
# FORUM_PRICING_TRUST_KEY_FILE=/path/to/ops-pricing-public.pem
# Option B: JSON registry (supports rotation; status=active|retired)
# FORUM_PRICING_TRUSTED_KEYS_JSON=[{"keyId":"fpk_v1","publicKey":"<spki-base64url>","status":"active"}]


# COOKIE 配置(备用，通常不用设置)
# COOKIE_SECRET=change-this-to-a-secure-random-string-in-production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.example.com
