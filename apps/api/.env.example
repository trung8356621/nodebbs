NODE_ENV=development

# Default response-message locale for this forum installation.
FORUM_DEFAULT_LOCALE=vi-VN

# 应用名，用于显示pm2服务等场景
APP_NAME=pbn

# 主机/端口
HOST=127.0.0.1
PORT=7100

# 数据库
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pbn_dev

# 缓存配置
REDIS_URL=redis://127.0.0.1:16379/0

# 用户信息缓存配置（秒）
# 用于缓存用户角色、封禁状态等信息，减少数据库查询
# 建议值：开发环境 30-60，生产环境 120-300
USER_CACHE_TTL=30

# JWT 使用 `openssl rand -base64 32` 生成
# Generate a random local secret before running the API; never commit it.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=1y

# CORS 跨域配置
# 支持逗号分隔的多个域名，支持通配符 (e.g. https://*.example.com)
CORS_ORIGIN=http://127.0.0.1:3100,http://localhost:3100

# COOKIE 配置(备用，通常不用设置)
# COOKIE_SECRET=change-this-to-a-secure-random-string-in-production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.example.com
