# 应用名，用于显示pm2服务等场景
APP_NAME=pbn

# 应用端口
PORT=3100

# 运行时 API 地址 (关键配置)
# 本地开发时，Next.js 服务器需要知道转发给谁
SERVER_API_URL=http://127.0.0.1:7100

# Must match the API AUTH_COOKIE_NAME (required when FORUM_ID is set on the API).
# Without this, SSR looks for auth_token while the API may set pbn_<forum>_auth,
# so refresh/navigation appears logged out despite a valid HttpOnly cookie.
# AUTH_COOKIE_NAME=pbn_forum_cholink_auth
# FORUM_ID=forum_cholink

# Locale for this forum installation (no locale prefix in URLs).
FORUM_DEFAULT_LOCALE=vi-VN
NEXT_PUBLIC_FORUM_DEFAULT_LOCALE=vi-VN

# Next.js 16+ development only: allow these hostnames to load /_next dev
# assets + HMR (wss) when accessing `next dev` via Cloudflare Tunnel / Tailscale.
# Without this, the page SSR-renders but React does not hydrate (login dead).
# Comma-separated bare hostnames (no scheme/port). Do not hardcode production domains in code.
# Example: ALLOWED_DEV_ORIGINS=pbn-dev.example.com,100.92.202.31
# ALLOWED_DEV_ORIGINS=
# Also accepted: FORUM_PUBLIC_ORIGIN=https://pbn-dev.example.com (hostname only is used)
# FORUM_PUBLIC_ORIGIN=

# Comma-separated peers allowed to keep incoming X-Forwarded-* on the Next process.
# Leave unset for local dev: a browser cannot spoof the client IP, and Next records the socket address.
# Same-host nginx that replaces X-Forwarded-For with $remote_addr:
# TRUSTED_EDGE_PROXIES=127.0.0.1,::1
