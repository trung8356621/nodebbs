# 应用名，用于显示pm2服务等场景
APP_NAME=pbn

# 应用端口
PORT=3100

# 运行时 API 地址 (关键配置)
# 本地开发时，Next.js 服务器需要知道转发给谁
SERVER_API_URL=http://127.0.0.1:7100

# Locale for this forum installation (no locale prefix in URLs).
FORUM_DEFAULT_LOCALE=vi-VN
NEXT_PUBLIC_FORUM_DEFAULT_LOCALE=vi-VN

# Next.js 16+ development only: allow these hostnames to load /_next dev
# assets + HMR (wss) when accessing `next dev` via Cloudflare Tunnel / Tailscale.
# Without this, the page SSR-renders but React does not hydrate (login dead).
# Comma-separated bare hostnames (no scheme/port). Do not hardcode production domains in code.
# Example: ALLOWED_DEV_ORIGINS=pbn-dev.example.com,100.92.202.31
# ALLOWED_DEV_ORIGINS=
# Also accepted: FORUM_PUBLIC_ORIGIN=https://pbn-dev.example.com (hostname only is used)
# FORUM_PUBLIC_ORIGIN=
